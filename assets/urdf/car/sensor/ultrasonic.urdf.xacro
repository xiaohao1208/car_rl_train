<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ultrasonic_xacro定义前向超声波测距坐标系 -->
  <xacro:macro name="ultrasonic_xacro" params="xyz">
    <link name="ultrasonic_link"/>

    <joint name="base_link_to_ultrasonic_link" type="fixed">
      <parent link="base_link"/>
      <child link="ultrasonic_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
