<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find car_description)/urdf/car/inertia.urdf.xacro"/>

  <!-- laser_xacro定义雷达支架和laser_link，YDLIDAR的/scan使用laser_link -->
  <xacro:macro name="laser_xacro" params="xyz laser_stand_mass laser_mass">
    <!-- 雷达支架节点 -->
    <link name="laser_stand_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.1" radius="0.01"/>
        </geometry>
        <material name="laser_stand_black">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.1" radius="0.01"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${laser_stand_mass}" r="0.01" h="0.1"/>
    </link>

    <joint name="laser_stand_joint" type="fixed">
      <!-- 支架固定到base_link，xyz表示支架底部相对车体的位置 -->
      <parent link="base_link"/>
      <child link="laser_stand_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>

    <!-- 雷达节点 -->
    <link name="laser_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.02" radius="0.02"/>
        </geometry>
        <material name="laser_black">
          <color rgba="0.01 0.01 0.01 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.02" radius="0.02"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${laser_mass}" r="0.02" h="0.02"/>
    </link>

    <joint name="laser_joint" type="fixed">
      <!-- laser_link位于支架顶部，z=0.0525让扫描平面高于车体 -->
      <parent link="laser_stand_link"/>
      <child link="laser_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>